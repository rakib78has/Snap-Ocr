{
  "manifest_version": 3,
  "name": "Snap OCR",
  "version": "1.3.1",
  "description": "Drag-select any area of your screen to get editable text. OCR runs locally in your browser with Tesseract.js.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Snap OCR - drag-select an area to extract text"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "account/account.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "commands": {
    "activate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Select an area of the screen to OCR"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
