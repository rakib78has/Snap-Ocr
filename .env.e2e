# Build used only by the end-to-end tests (npm run build:e2e). It talks to the
# local Firebase emulators under a "demo-" project id, which the emulators
# treat as offline-only: nothing here can reach a real Firebase project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-snap-ocr.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-snap-ocr
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_STRIPE_PRICE_ID=price_e2e_monthly
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
