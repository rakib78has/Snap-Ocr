# Copy to .env.production.local (git-ignored) and fill in from the Firebase
# console: Project settings → General → Your apps → Web app → SDK config.
# These values identify the project; they are not secrets. Access is
# protected by Firebase Auth and firestore.rules, not by hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Stripe Price ID of the monthly plan (Stripe dashboard → Product → Pricing),
# e.g. price_1Abc... The free trial length is configured on that price.
VITE_STRIPE_PRICE_ID=

# Region the "Run Payments with Stripe" extension was installed in.
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
